<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.3/phpunit.xsd"
         bootstrap="tests/bootstrap.php" colors="true" recordTestRunHistory="false"
         failOnWarning="true" failOnRisky="true" failOnDeprecation="true"
         failOnPhpunitDeprecation="true">
    <testsuites>
        <testsuite name="Users">
            <directory>tests/Unit</directory>
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="Authentication">
            <directory>tests/Auth</directory>
        </testsuite>
        <testsuite name="Requests">
            <directory>tests/Requests</directory>
        </testsuite>
        <testsuite name="Workflow">
            <directory>tests/Workflow</directory>
        </testsuite>
        <testsuite name="Comments">
            <directory>tests/Comments</directory>
        </testsuite>
    </testsuites>
</phpunit>
