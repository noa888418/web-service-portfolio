{
    "name": "portfolio/it-requests",
    "type": "project",
    "description": "Internal IT request portfolio: users foundation",
    "license": "proprietary",
    "require": {
        "php": "~8.4.0",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo_pgsql": "*",
        "ext-xml": "*",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {"App\\": "app/"}
    },
    "autoload-dev": {
        "psr-4": {"Tests\\": "tests/"}
    },
    "config": {
        "allow-plugins": {},
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    }
}
